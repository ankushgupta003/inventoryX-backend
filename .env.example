# Local Postgres example:
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/inventoryx
# Neon example:
# DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@inventoryx.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
# Comma-separate multiple origins if you want to allow local and deployed frontends at the same time.
FRONTEND_URL=http://localhost:5173

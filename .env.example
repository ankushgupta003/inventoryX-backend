# Local Postgres example:
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/inventoryx
# Neon example:
# DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15
# Production: generate long random values and keep them only in your host's secret manager.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=replace-with-your-super-admin-email
# Bootstrap-only password. Use it for first login, then change the password inside the app.
SUPER_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
# Comma-separate multiple origins if you want to allow local and deployed frontends at the same time.
FRONTEND_URL=http://localhost:5173
